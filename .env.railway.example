# Copy into Railway service Variables. Fill values there, never in GitHub or chat.
# Keep tokens blank until the catalogue and persistent volume are ready.
NODE_ENV=production
HOST=0.0.0.0
# Railway supplies PORT; do not copy a local PORT override.
RUNTIME_DATA_DIR=/data/runtime
ALLOW_TEST_CHAT=false
ALLOW_INTEGRATION_ERROR_READ=false
# Keep disabled during staging. Webhooks can run without the poller.
INSTAGRAM_POLLER_ENABLED=false

# Your approved catalogue: Projects, Units, Price History and Market Snapshot.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Values for the Meta app and Instagram account you control.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=


# Advisor alerts for approved follow-up actions, subject to contact restrictions.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALERT_TO=
WHATSAPP_TEMPLATE_NAME=lead_alert
WHATSAPP_TEMPLATE_LANGUAGE=en

# Your details for customer handoffs. The bot uses only what is set here and
# never invents contact details; with none set it refers to "our team".
BROKER_NAME=
BROKER_ROLE=
BROKER_PHONE=
BROKER_WHATSAPP=
BROKER_EMAIL=
# Must be an https:// link, for example your calendar booking page.
BROKER_BOOKING_URL=
# Complementary services the bot may suggest; enable them in data/services.json.
# SERVICES_PATH=data/services.json

FACT_MAX_AGE_DAYS=30
AVAILABILITY_MAX_AGE_DAYS=1

# Optional serving research tables; see docs/OFF-PLAN-RESEARCH-INTEGRATION.md.
# These values match runtime defaults and do not approve commercial quotes.
AIRTABLE_PRICE_HISTORY_TABLE=Price History
AIRTABLE_MARKET_SNAPSHOT_TABLE=Market Snapshot
AIRTABLE_AREAS_TABLE=Areas (research)
AIRTABLE_AREA_GUIDE_TABLE=Area Guide
AIRTABLE_RESEARCH_OFFERS_TABLE=Offers (research)
AIRTABLE_PROJECT_RELATIONSHIPS_TABLE=Project Relationships (research)
AIRTABLE_INVESTMENT_EVIDENCE_TABLE=Investment Evidence (research)
# Explicit payment-table opt-in. Draft / bot-disabled schedules remain UNKNOWN.
# Stage Railway changes only after tests pass; these examples do not deploy.
AIRTABLE_PAYMENT_SCHEDULES_TABLE=Payment Schedules (research)

# Conversation outcomes and the daily report (docs/CONVERSATION-OUTCOMES.md).
# OUTCOME_FINAL_AFTER_HOURS=48
# Broker alerts and the daily report by email (Resend; Railway blocks SMTP).
RESEND_API_KEY=
ALERT_EMAIL_TO=
# EMAIL_FROM=Instagram property bot <alerts@your-domain.com>
REPORT_DELIVERY_ENABLED=false
# REPORT_HOUR_DUBAI=11
# REPORT_EMAIL_TO=   (defaults to ALERT_EMAIL_TO)
# REPORT_RECIPIENT=9715XXXXXXXX   (WhatsApp, used only without email)
