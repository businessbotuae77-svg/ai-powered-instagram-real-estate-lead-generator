# Copy to .env and fill in. Never commit .env.

# Airtable (Milestone 1+)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appbIG0pZvueaTp07

# Server
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
# Set true on Railway with a mounted volume path for durable state.
# RUNTIME_DATA_DIR=/data/runtime
ALLOW_TEST_CHAT=true
# ALLOW_INTEGRATION_ERROR_READ=true

# Optional path overrides
# QUALIFICATION_CHOICES_PATH=data/qualification-choices.json
# CONVERSATION_PREFERENCES_PATH=data/conversation-preferences.json

# Meta Instagram Messaging (Milestone 3)
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
# META_GRAPH_VERSION=v21.0
# META_GRAPH_BASE_URL=https://graph.facebook.com

# Meta WhatsApp Cloud API — advisor alert only after Request a Call + phone submit
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALERT_TO=
WHATSAPP_TEMPLATE_NAME=lead_alert
WHATSAPP_TEMPLATE_LANGUAGE=en

# Approved commercial facts: positive day limits. Defaults shown.
# Your details for customer handoffs. The bot uses only what is set here and
# never invents contact details; with none set it refers to "our team".
BROKER_NAME=
BROKER_ROLE=
BROKER_PHONE=
BROKER_WHATSAPP=
BROKER_EMAIL=
# Must be an https:// link, for example your calendar booking page.
BROKER_BOOKING_URL=
# Complementary services the bot may suggest; enable them in data/services.json.
# SERVICES_PATH=data/services.json

FACT_MAX_AGE_DAYS=30
AVAILABILITY_MAX_AGE_DAYS=1

# Optional serving research tables; see docs/OFF-PLAN-RESEARCH-INTEGRATION.md.
# These values match runtime defaults and do not approve commercial quotes.
AIRTABLE_PRICE_HISTORY_TABLE=Price History
AIRTABLE_MARKET_SNAPSHOT_TABLE=Market Snapshot
AIRTABLE_AREAS_TABLE=Areas (research)
AIRTABLE_AREA_GUIDE_TABLE=Area Guide
AIRTABLE_RESEARCH_OFFERS_TABLE=Offers (research)
AIRTABLE_PROJECT_RELATIONSHIPS_TABLE=Project Relationships (research)
AIRTABLE_INVESTMENT_EVIDENCE_TABLE=Investment Evidence (research)
# Explicit payment-table opt-in. Draft / bot-disabled schedules remain UNKNOWN.
# Stage Railway changes only after tests pass; these examples do not deploy.
AIRTABLE_PAYMENT_SCHEDULES_TABLE=Payment Schedules (research)
